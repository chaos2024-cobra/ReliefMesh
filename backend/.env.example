# ReliefMesh backend configuration example.
# Copy this file to `.env` and adjust values as needed. All values are optional;
# the defaults below match local development.

# --- Application ---
APP_NAME="ReliefMesh API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database ---
# SQLite by default (file is created relative to the backend directory).
DATABASE_URL=sqlite:///./reliefmesh.db

# --- Startup behaviour ---
# Creating tables automatically is convenient for development; in production
# you would usually run migrations explicitly and set this to false.
AUTO_INIT_DB=true
# Seed (idempotently) the demo Thanjavur flood scenario on startup.
AUTO_SEED=true

# --- CORS ---
# Comma-separated list of allowed frontend origins (Vite/React defaults first).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# --- Planning engine (Phase 2; all values are SIMULATED demo assumptions) ---
# Consumption rates are per person per day.
PLANNING_WATER_LITRES_PER_PERSON_PER_DAY=3.0
PLANNING_FOOD_KITS_PER_PERSON_PER_DAY=0.2
PLANNING_MEDICAL_KITS_PER_PERSON_PER_DAY=0.02
PLANNING_HYGIENE_KITS_PER_PERSON_PER_DAY=0.1
# Route-cost penalty minutes per unit of normalised (0-1) route risk.
PLANNING_RISK_PENALTY_MINUTES=120.0
# Demand priority score weights (must sum to 1.0).
PLANNING_PRIORITY_COMPONENT_WEIGHT=0.40
PLANNING_SHORTAGE_COMPONENT_WEIGHT=0.35
PLANNING_POPULATION_COMPONENT_WEIGHT=0.15
PLANNING_SUPPLY_RISK_COMPONENT_WEIGHT=0.10

# --- Dispatch / fleet execution (Phase 4) ------------------------------------
# Simulated execution assumptions; cargo weights live in
# app/core/dispatch_config.py (water 1 kg/L, food 2 kg/kit, medical 1 kg/kit,
# hygiene 2 kg/kit).
DISPATCH_ADVANCE_STEP_MINUTES=60
DISPATCH_DELAY_THRESHOLD_MINUTES=5
DISPATCH_MIN_CARGO_WEIGHT_KG=0

# --- Gemini AI orchestrator (Phase 3) ---------------------------------------
# The real key lives ONLY in backend/.env (already excluded from Git).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=true
# Manual function-calling loop safeguards.
GEMINI_MAX_TOOL_ITERATIONS=6
GEMINI_MAX_TOOL_CALLS=10
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_SECONDS=60
# Recent conversation messages sent to the model per turn.
GEMINI_HISTORY_WINDOW=10
