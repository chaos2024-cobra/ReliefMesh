# ReliefMesh Mobile — field app configuration
# Copy to .env and fill in values.

# Backend API base URL.
# For physical device on same WiFi: use your computer's local IP (find with `ipconfig`)
# For Android Emulator:            http://10.0.2.2:8000/api/v1
# For iOS Simulator:               http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Google Maps JavaScript API key (same key as frontend)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Emergency SMS dispatch number for offline SOS fallback
EXPO_PUBLIC_EMERGENCY_SMS_NUMBER=+911234567890
