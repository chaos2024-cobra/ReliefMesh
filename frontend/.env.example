# ReliefMesh frontend configuration examples.
# Copy to `.env` and adjust. Never put backend secrets here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Maps JavaScript API browser key. Restrict this key by HTTP referrer
# and enable Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for Advanced Markers. DEMO_MAP_ID works for development / Demo Key use.
# For the dark grayscale look, create a vector Map ID with a custom style in
# Google Cloud Console (Map Management) and put its ID here.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
